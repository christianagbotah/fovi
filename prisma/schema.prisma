generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  emailVerifyToken String?
  emailVerifyExpiry DateTime?
  resetToken     String?
  resetTokenExpiry DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts       TradingAccount[]
  settings       UserSettings?
  aiConversations AiConversation[]
  bots           Bot[]
  backtests      Backtest[]
  subscriptions  Subscription[]
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAccountId String?
  riskTolerance   String   @default("medium")
  autoTradeEnabled Boolean @default(false)
  notificationsEnabled Boolean @default(true)
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod String @default("totp")  // totp, sms, email
  twoFactorSecret String?
  phoneNumber String?
  smsEnabled      Boolean  @default(false)
  smsOtpEnabled   Boolean  @default(false)
  emailOtpEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker          String
  accountType     String   @default("demo")
  accountId       String?
  apiKey          String?
  apiSecret       String?
  passphrase      String?
  isDefault       Boolean  @default(false)
  balance         Float    @default(100000.0)
  linkedBalance   Float    @default(100000.0)
  totalAllocated  Float    @default(0)
  totalRealizedProfit  Float    @default(0)
  totalAdminLevyCollected  Float    @default(0)
  currency        String   @default("USD")
  isActive        Boolean  @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  positions       Position[]
  orders          Order[]
  signals         TradingSignal[]
  botConfigs      BotConfig[]
  bots            Bot[]
}

model Position {
  id              String   @id @default(cuid())
  accountId       String
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  botId           String?
  symbol          String
  name            String?
  assetType       String   @default("stock")
  side            String
  qty             Float
  avgEntryPrice   Float
  currentPrice    Float    @default(0)
  unrealizedPnl   Float    @default(0)
  realizedPnl     Float    @default(0)
  stopLoss        Float?
  takeProfit      Float?
  trailingStop    Float?
  trailingStopPct Float?   // trailing stop %
  status          String   @default("open")
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot             Bot?       @relation(fields: [botId], references: [id])
}

model Order {
  id              String   @id @default(cuid())
  accountId       String
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  botId           String?
  brokerOrderId   String?
  symbol          String
  assetType       String   @default("stock")
  side            String
  type            String   @default("market")
  qty             Float
  limitPrice      Float?
  stopPrice       Float?
  filledQty       Float    @default(0)
  filledPrice     Float?
  status          String   @default("pending")
  aiGenerated     Boolean  @default(false)
  signalId        String?
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signal          TradingSignal? @relation(fields: [signalId], references: [id])
  bot             Bot?       @relation(fields: [botId], references: [id])
}

model TradingSignal {
  id              String   @id @default(cuid())
  accountId       String
  account         TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  botId           String?
  symbol          String
  assetType       String   @default("stock")
  direction       String
  confidence      Float
  signalType      String
  timeframe       String   @default("1h")
  entryPrice      Float?
  stopLoss        Float?
  takeProfit      Float?
  targetPnl       Float?
  reasoning       String?
  status          String   @default("active")
  executedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  bot             Bot?       @relation(fields: [botId], references: [id])
}

model BotConfig {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(false)
  allocationAmount  Float    @default(0)
  riskTolerance     String   @default("medium")
  maxPositions      Int      @default(5)
  maxPositionSize   Float    @default(0)
  stopLossPercent   Float    @default(2.0)
  takeProfitPercent Float    @default(4.0)
  strategy          String   @default("balanced")
  status            String   @default("stopped")
  adminLevyPercent   Float    @default(10)
  adminLevyCollected Float    @default(0)
  grossPnl          Float    @default(0)
  totalTrades       Int      @default(0)
  winTrades         Int      @default(0)
  totalPnl          Float    @default(0)
  lastTradeAt       DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Multiple Bots - each with its own strategy, allocation, and stats
model Bot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  strategy          String   // signal_based, dca, grid, scalping, momentum
  symbols           String   // comma-separated symbols
  timeframe         String   @default("1h")
  allocationAmount  Float    @default(0)
  enabled           Boolean  @default(false)
  status            String   @default("stopped") // running, paused, stopped
  // Strategy-specific config (JSON)
  config            String   @default("{}")
  // Risk management
  positionSizing    String   @default("fixed_fractional") // kelly, fixed_fractional, volatility, fixed
  riskPerTrade      Float    @default(2.0) // % of allocation per trade
  maxPositions      Int      @default(3)
  stopLossPercent   Float    @default(2.0)
  takeProfitPercent Float    @default(4.0)
  trailingStopPct   Float    @default(0)
  // Session scheduling
  tradingSessions   String   @default("all") // all, london, newyork, asia, custom
  customSessionStart String? // HH:mm
  customSessionEnd   String? // HH:mm
  // Stats
  totalTrades       Int      @default(0)
  winTrades         Int      @default(0)
  lossTrades        Int      @default(0)
  totalPnl          Float    @default(0)
  bestTrade         Float    @default(0)
  worstTrade        Float    @default(0)
  currentStreak     Int      @default(0)
  lastTradeAt       DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  positions         Position[]
  orders            Order[]
  signals           TradingSignal[]
}

// Backtest results
model Backtest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  strategy        String
  symbol          String
  timeframe       String   @default("1d")
  startDate       DateTime
  endDate         DateTime
  initialBalance  Float
  finalBalance    Float
  totalPnl        Float    @default(0)
  pnlPercent      Float    @default(0)
  totalTrades     Int      @default(0)
  winTrades       Int      @default(0)
  lossTrades      Int      @default(0)
  maxDrawdown     Float    @default(0)
  sharpeRatio     Float    @default(0)
  sortinoRatio    Float    @default(0)
  profitFactor    Float    @default(0)
  avgWin          Float    @default(0)
  avgLoss         Float    @default(0)
  config          String   @default("{}") // JSON strategy config used
  tradesJson      String   @default("[]") // JSON array of simulated trades
  equityCurveJson String   @default("[]") // JSON array of balance snapshots
  createdAt       DateTime @default(now())
}

// Trade journal entries (AI-generated insights)
model TradeJournal {
  id              String   @id @default(cuid())
  userId          String
  positionId      String?
  orderId         String?
  symbol          String
  side            String
  entryPrice      Float
  exitPrice       Float?
  qty             Float
  pnl             Float?
  pnlPercent      Float?
  entryReason     String?  // why the trade was opened
  exitReason      String?  // why it was closed
  aiInsight       String?  // AI analysis of the trade
  lessons         String?  // what to learn
  rating          Int?     // 1-5 user rating
  tags            String?  // comma-separated tags
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Webhook configurations for external signals
model WebhookConfig {
  id              String   @id @default(cuid())
  userId          String
  name            String
  url             String   // incoming webhook URL path (unique per user)
  secret          String?  // HMAC secret for verification
  enabled         Boolean  @default(true)
  autoExecute     Boolean  @default(false) // auto-execute or just create signal
  defaultStrategy String   @default("signal_based")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MarketData {
  id              String   @id @default(cuid())
  symbol          String
  assetType       String   @default("stock")
  timeframe       String   @default("1d")
  open            Float
  high            Float
  low             Float
  close           Float
  volume          Float    @default(0)
  timestamp       DateTime

  @@unique([symbol, timeframe, timestamp])
}

model WatchlistItem {
  id              String   @id @default(cuid())
  userId          String
  symbol          String
  name            String?
  assetType       String   @default("stock")
  addedAt         DateTime @default(now())

  @@unique([userId, symbol])
}

model AiConversation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  messages        AiMessage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         String
  metadata        String?
  createdAt       DateTime @default(now())
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SmsOtp {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  code        String
  purpose     String   @default("login")
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model EmailOtp {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  code      String
  purpose   String   @default("login")
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  status          String   @default("active")
  hubtelInvoiceId String?
  hubtelResponse  String?
  amount          Float
  currency        String   @default("GHS")
  startedAt       DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrokerProvider {
  id              String   @id @default(cuid())
  code            String   @unique  // internal code: 'binance', 'okx', 'bybit', 'bitget', 'alpaca', 'mt5', 'demo', or custom like 'kucoin'
  displayName     String              // 'Binance', 'OKX', etc.
  description     String   @default("")
  brokerType      String   @default("crypto")  // crypto, stocks, forex, cfd, demo
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  iconColor       String   @default("#F0B90B")  // hex color for the icon
  requiresApiKey  Boolean  @default(true)
  requiresSecret  Boolean  @default(true)
  requiresPassphrase Boolean @default(false)
  liveBaseUrl     String   @default("")   // REST API base URL for live trading
  testnetBaseUrl  String   @default("")   // REST API base URL for demo/testnet
  // --- Generic REST broker configuration ---
  authType        String   @default("none")  // none, api_key_header, api_key_query, hmac_sha256, hmac_sha256_base64, bearer
  apiKeyHeader    String   @default("")   // header name for API key, e.g. 'X-MBX-APIKEY'
  symbolFormat    String   @default("pair")  // pair (BTCUSDT), slash (BTC/USDT), dot (BTC.USDT), underscore (BTC_USDT)
  customEndpoints String   @default("{}")  // JSON: endpoint paths for generic REST broker
  assetTypes      String   @default("[]")  // JSON array: ["crypto","forex"]
  supportedFeatures String @default("[]")  // JSON array: ["spot","futures","options"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  price       Float
  currency    String   @default("GHS")
  features    String   @default("[]")
  maxBots     Int      @default(1)
  maxAccounts Int      @default(1)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
