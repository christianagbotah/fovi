{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": [
    "auto-trade-engine/**/*.ts",
    "balance-sync/**/*.ts",
    "market-service/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
