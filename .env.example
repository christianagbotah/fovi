# ============================================================
# Fovi AI Trading Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# REQUIRED values are marked with [REQUIRED].
# ============================================================
#
# PHASE 1 / PHASE 2D — LIVE TRADING REMAINS DISABLED
# ────────────────────────────────────────────────────
# The following capabilities remain DISABLED and cannot be enabled by the
# Phase 2D paper-execution work:
#
#   - Live trading (real-money order execution)
#   - Broker credential intake (connecting real broker accounts)
#   - Automated real-money trading (engine execution on live brokers)
#   - Balance synchronization with live broker accounts
#
# Do NOT configure BINANCE_API_KEY, BINANCE_API_SECRET,
# OKX_API_KEY, OKX_API_SECRET, OKX_PASSPHRASE,
# ALPACA_API_KEY, or ALPACA_API_SECRET.
# These are not used by the contained runtime and will be rejected.
#
# The flags below document the disabled state. LIVE_TRADING_ENABLED and
# AUTOMATED_TRADING_ENABLED do NOT authorize live trading under containment.
#
# LIVE_TRADING_ENABLED=false
# BROKER_CREDENTIAL_INTAKE_ENABLED=false
# AUTOMATED_TRADING_ENABLED=false
# BALANCE_SYNC_ENABLED=false
#
# Phase 2D adds a separate internal paper-execution adapter. It is OFF by
# default and may be enabled only for controlled demo/sandbox validation after
# the complete open/close/restart reconciliation path is approved. It never
# constructs a live broker and never authorizes real-money execution.
PAPER_AUTOMATED_EXECUTION_ENABLED=false
#
# ============================================================

# ── Database ──
# [REQUIRED in production] PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
# For local dev with SQLite:
# DATABASE_URL="file:./db/custom.db"

# ── Authentication ──
# [REQUIRED in production] Secret for signing JWT tokens.
# Generate with: openssl rand -base64 48
# Must be >= 32 characters. Production will refuse to start without this.
JWT_SECRET=""

# [REQUIRED in production] Pepper added to password hashes.
# Generate with: openssl rand -hex 32
# Must be >= 16 characters. Production will refuse to start without this.
AUTH_PEPPER=""

# Admin email (first user with this email becomes admin)
ADMIN_EMAIL="admin@example.com"

# ── Application URL ──
# [REQUIRED in production] Base URL for password reset emails, OAuth callbacks.
# Must be a valid HTTPS URL in production.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
APP_URL="https://yourdomain.com"

# ── SMTP (Email) ──
# Required for: password reset, email verification, email OTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Fovi AI <noreply@yourdomain.com>"

# ── Hubtel (SMS + Payments — Ghana Mobile Money) ──
# Configure via Admin UI, or pre-set here:
# HUBTEL_SMS_CLIENT_ID=""
# HUBTEL_SMS_CLIENT_SECRET=""
# HUBTEL_SMS_SENDER_NAME="FoviAI"
# HUBTEL_PAYMENT_CLIENT_ID=""
# HUBTEL_PAYMENT_CLIENT_SECRET=""
# HUBTEL_PAYMENT_ACCOUNT_NUMBER=""
# HUBTEL_PAYMENT_CALLBACK_URL="https://yourdomain.com/api/payments/hubtel/callback"

# ── Security ──
# [REQUIRED in production] Key for encrypting broker API keys at rest.
# Generate with: openssl rand -base64 32
# Must be >= 32 characters. Production will refuse to start without this.
ENCRYPTION_KEY=""

# [REQUIRED in production] Shared secret for internal mini-service auth.
# Mini-services (balance-sync, auto-trade-engine, market-service) use this
# to authenticate with the Next.js API when calling internal endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=""

# ── Market Data (Optional — enhances real-time data) ──
# Crypto prices work via CoinGecko without a key (free tier).
# Set this for real stock/forex/commodity/index prices:
# FINNHUB_API_KEY="your-finnhub-key"  # Free at finnhub.io
