# Required — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://lightworld_db_user:YOUR_PASSWORD@localhost:5432/lighworld_fovi_db"

# Optional: NextAuth (uncomment and set for production auth)
# NEXTAUTH_URL=https://fovi.lightworldtech.com
# NEXTAUTH_SECRET="your-random-secret-here"

# Broker API Keys (set in UI, or pre-configure here)
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
