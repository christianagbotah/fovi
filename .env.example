# ============================================================
# Fovi AI Trading Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# REQUIRED values are marked with [REQUIRED].
# ============================================================

# ── Database ──
# [REQUIRED in production] PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
# For local dev with SQLite:
# DATABASE_URL="file:./db/custom.db"

# ── Authentication ──
# [REQUIRED in production] Secret for signing JWT tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-64-char-string"

# [REQUIRED in production] Pepper added to password hashes.
# Generate with: openssl rand -hex 32
AUTH_PEPPER="change-me-to-a-random-64-char-hex-string"

# Admin email (first user with this email becomes admin)
ADMIN_EMAIL="admin@example.com"

# ── Application URL ──
# [REQUIRED in production] Base URL for password reset emails, OAuth callbacks
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
APP_URL="https://yourdomain.com"

# ── SMTP (Email) ──
# Required for: password reset, email verification, email OTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Fovi AI <noreply@yourdomain.com>"

# ── Hubtel (SMS + Payments — Ghana Mobile Money) ──
# Configure via Admin UI, or pre-set here:
# HUBTEL_SMS_CLIENT_ID=""
# HUBTEL_SMS_CLIENT_SECRET=""
# HUBTEL_SMS_SENDER_NAME="FoviAI"
# HUBTEL_PAYMENT_CLIENT_ID=""
# HUBTEL_PAYMENT_CLIENT_SECRET=""
# HUBTEL_PAYMENT_ACCOUNT_NUMBER=""
# HUBTEL_PAYMENT_CALLBACK_URL="https://yourdomain.com/api/payments/hubtel/callback"

# ── Market Data (Optional — enhances real-time data) ──
# Crypto prices work via CoinGecko without a key (free tier).
# Set this for real stock/forex/commodity/index prices:
# FINNHUB_API_KEY="your-finnhub-key"  # Free at finnhub.io

# ── Broker API Keys (users set these in the UI per account) ──
# Pre-configure if you want platform-level broker access:
# BINANCE_API_KEY=""
# BINANCE_API_SECRET=""
# OKX_API_KEY=""
# OKX_API_SECRET=""
# OKX_PASSPHRASE=""
# ALPACA_API_KEY=""
# ALPACA_API_SECRET=""
